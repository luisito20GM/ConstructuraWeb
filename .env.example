# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PORT=3000

# =============================================
# BASE DE DATOS MYSQL
# Llena estos datos con los de tu servidor MySQL
# =============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=TU_PASSWORD_MYSQL
DB_NAME=construrenta_db

# =============================================
# SEGURIDAD - JWT
# Cambia este texto por cualquier frase larga y secreta
# =============================================
JWT_SECRET=construrenta_clave_super_secreta_2025

# =============================================
# CORREO ELECTRÓNICO (para enviar cotizaciones)
# Usa una cuenta de Gmail
# En Gmail debes activar "Contraseñas de aplicación"
# =============================================
EMAIL_USER=TU_CORREO@gmail.com
EMAIL_PASS=TU_CONTRASEÑA_DE_APLICACION
EMAIL_DESTINO=CORREO_DONDE_RECIBES_COTIZACIONES@gmail.com

# =============================================
# NOMBRE DEL NEGOCIO (aparece en correos y PDFs)
# =============================================
NOMBRE_EMPRESA=ConstruRenta y Venta
TELEFONO_EMPRESA={{TELEFONO}}
DIRECCION_EMPRESA={{DIRECCION}}
